genrule(
    name = "format_cpp",
    outs = ["format_cpp.sh"],
    binary = True,
    cmd = [
        "echo '#!/bin/bash' > $OUTS",
        "echo 'echo \"Formatting C/C++ source files...\"' >> $OUTS",
        "echo 'find src/RFL playground \\( -name \"cmake-build*\" -o -name \"build*\" -o -name \"_deps\" -o -name \".vscode\" -o -name \".pytest_cache\" \\) -prune -o -type f \\( -name \"*.cpp\" -o -name \"*.hpp\" -o -name \"*.h\" -o -name \"*.c\" \\) -exec clang-format -i {} +' >> $OUTS",
        "chmod +x $OUTS",
    ],
    visibility = ["PUBLIC"],
)

genrule(
    name = "lint_cpp",
    outs = ["lint_cpp.sh"],
    binary = True,
    cmd = [
        "echo '#!/bin/bash' > $OUTS",
        "echo 'echo \"Checking C/C++ source files formatting...\"' >> $OUTS",
        "echo 'find src/RFL playground \\( -name \"cmake-build*\" -o -name \"build*\" -o -name \"_deps\" -o -name \".vscode\" -o -name \".pytest_cache\" \\) -prune -o -type f \\( -name \"*.cpp\" -o -name \"*.hpp\" -o -name \"*.h\" -o -name \"*.c\" \\) -exec clang-format --dry-run -Werror {} +' >> $OUTS",
        "chmod +x $OUTS",
    ],
    visibility = ["PUBLIC"],
)

genrule(
    name = "lint_spelling",
    outs = ["lint_spelling.sh"],
    binary = True,
    cmd = [
        "echo '#!/bin/bash' > $OUTS",
        "echo 'echo \"Checking spelling compliance (CSpell)...\"' >> $OUTS",
        "echo 'npx cspell lint \"**/*.{cpp,hpp,h,c,py,md,cmake,txt}\"' >> $OUTS",
        "chmod +x $OUTS",
    ],
    visibility = ["PUBLIC"],
)

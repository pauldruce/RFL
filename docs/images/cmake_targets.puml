@startuml
' RFL Modular CMake Target Architecture (C4 Model Palette)
' Regenerate SVG: java -jar plantuml.jar -tsvg cmake_targets.puml
' Or via CLI: plantuml -tsvg cmake_targets.puml

skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Helvetica, Arial, sans-serif"
skinparam defaultFontSize 11
skinparam roundcorner 6
skinparam shadowing false
skinparam linetype ortho

skinparam rectangle {
  BorderColor #cbd5e1
  BackgroundColor #f8fafc
  FontColor #334155
  FontStyle bold
  BorderThickness 1.5
}

skinparam component {
  BorderColor #2563eb
  BackgroundColor #eff6ff
  FontColor #1e40af
  BorderThickness 1.5
  ArrowColor #475569
  ArrowFontColor #334155
  ArrowFontSize 10
}

skinparam component<<STATIC>> {
  BorderColor #2563eb
  BackgroundColor #f0f7ff
  FontColor #1e40af
}

skinparam component<<INTERFACE>> {
  BorderColor #1d4ed8
  BackgroundColor #eff6ff
  FontColor #1e3a8a
}

skinparam component<<third-party>> {
  BorderColor #64748b
  BackgroundColor #ffffff
  FontColor #334155
}

rectangle "rfl Targets (src/RFL/core)" as rfl_group {
  [**rfl_core**\n--\nConsumer Aggregator Target] as core <<INTERFACE>>

  [**rfl_mcmc**\n--\nAction • Metropolis • Simulation] as mcmc <<STATIC>>

  [**rfl_geometry**\n--\nDiracOperator • CliffordModule] as geom <<STATIC>>

  [**rfl_rng**\n--\nGslRng • IRng] as rng <<STATIC>>
}

rectangle "Third-Party Libraries" as ext_group {
  [**Armadillo C++**\n--\ncx_mat, BLAS, LAPACK] as arma <<third-party>>
  [**GSL**\n--\ngsl_rng] as gsl <<third-party>>
}

core ..> mcmc : aggregates
core ..> geom : aggregates
core ..> rng : aggregates

mcmc ..> geom : links
mcmc ..> rng : links

geom ..> arma : links
rng ..> gsl : links

@enduml

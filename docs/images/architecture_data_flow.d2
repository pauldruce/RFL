# RFL System Architecture & Data Flow
# Regenerate SVG: d2 architecture_data_flow.d2 architecture_data_flow.svg

direction: down

py: "pyrfl:\nPython Entrypoint" {
  class: internal_component
  shape: rectangle
}

obs: "Telemetry & Observables\n«sink»\n--\nISimulationObserver • Recorders" {
  class: internal_component
}

sampler: "MetropolisSampler\n«algorithm»\n--\nDualAveraging calibration" {
  class: internal_component
}

action: "BarrettGlaserAction\n«energy functional»\n--\nS = g₂ Tr(D²) + g₄ Tr(D⁴)" {
  class: internal_component
}

dirac: "DiracOperator\n«value type»\n--\nMatrix spectral state" {
  class: internal_component
}

clifford: "CliffordModule (p, q)\n«representation»\n--\nGamma matrices • Trace table" {
  class: internal_component
}

arma: "Armadillo C++\n«third-party»\n--\ncx_mat • BLAS • LAPACK" {
  class: external_system
}

rng: "Stochastic Engine\n«third-party»\n--\nGSL Random Number Gen" {
  class: external_system
}

# Execution & Data Flow
py -> sampler: configures {style.stroke-dash: 4}
py -> dirac: inspects {style.stroke-dash: 4}

sampler -> rng: draws variates {style.stroke-dash: 4}
sampler -> obs: notifies {style.stroke-dash: 4}
sampler -> action: queries variation ΔS
sampler -> dirac: proposes updates

dirac -> clifford: uses
dirac -> arma: delegates

action -> dirac: evaluates {style.stroke-dash: 4}

# Sylings
classes: {
  # Components
  internal_component: {
    style: {
      fill: "#eff6ff"
      stroke: "#1d4ed8"
      stroke-width: 2
      border-radius: 6
      font-color: "#1e3a8a"
    }
  }
  external_system: {
    style: {
      fill: "#ffffff"
      stroke: "#64748b"
      stroke-width: 2
      border-radius: 6
      font-color: "#334155"
    }
  }
  # Arrow Styles
  system_boundary: {
    style: {
      stroke-dash: 5
      fill: "#f8f9fa"
    }
  }
  container_boundary: {
    style: {
      stroke-dash: 3
      fill: "#e9ecef"
    }
  }
}

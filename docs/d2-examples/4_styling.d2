# Primary target / entry point (C4 Deep Blue)
core: "rfl_core" {
  style.fill: "#eff6ff"
  style.stroke: "#1d4ed8"
  style.stroke-width: 2
  style.border-radius: 6
  style.font-color: "#1e3a8a"
}

# Internal components (C4 Component Blue)
mcmc: "rfl_mcmc" {
  style.fill: "#f0f7ff"
  style.stroke: "#2563eb"
  style.border-radius: 6
}

# External third-party libraries (C4 Slate / Grey)
external: "Armadillo C++" {
  style.fill: "#ffffff"
  style.stroke: "#64748b"
  style.border-radius: 6
}

# RFL CI Execution Planner and Change Impact Analyser (C4 Component Diagram)
# Regenerate SVG: python3 scripts/check_d2_images.py --fix

direction: down

inputs: "Repository and Git Inputs" {
  style: {
    fill: "#f8fafc"
    stroke: "#cbd5e1"
    stroke-width: 2
    border-radius: 8
  }

  git_diff: "Git Diff and Commit Trailers\n«git»\n--\nChanged files • EP row diffs\nImplements: REQ-..." {
    class: external_system
  }

  codebase: "C++, Python and Build Config\n«codebase»\n--\nsrc/core/ • bindings.cpp\npyproject.toml • CMakeLists.txt" {
    class: external_system
  }

  specs: "EP Specifications and Tagged Tests\n«traceability»\n--\ndocs/eps/ep-*.md tables\nGTest and Pytest [REQ-...] tags" {
    class: external_system
  }
}

planner: "CI Execution Planner and Traceability Subsystem" {
  style: {
    fill: "#f8fafc"
    stroke: "#94a3b8"
    stroke-width: 2
    stroke-dash: 4
    border-radius: 8
  }

  graph_builder: "1. Dependency Graph Builder\n«ci_plan.py»\n--\nC++ #include resolution cache\nbindings.cpp py::class_ -> Python AST" {
    class: internal_component
  }

  hop1: "2. Component and Test Resolver\n«ci_plan.py»\n--\nReverse dependency BFS traversal\npyproject.toml / CMake build-wide triggers" {
    class: internal_component
  }

  hop2: "3. Requirement Impact Analyser\n«ci_plan.py + verify_traceability.py»\n--\nExtracts REQ IDs from affected tests,\nmodified EP table rows, and Git trailers" {
    class: internal_component
  }

  hop3: "4. Test Closure and Job Planner\n«ci_plan.py»\n--\nExpands impacted REQs to all mapped tests\nEmits plan.json, ctest_filter and GITHUB_OUTPUT" {
    class: internal_component
  }

  graph_builder -> hop1: reverse_deps graph
  hop1 -> hop2: affected C++ and Python tests
  hop2 -> hop3: impacted_requirements
}

consumers: "Execution and Governance Gates" {
  style: {
    fill: "#f8fafc"
    stroke: "#cbd5e1"
    stroke-width: 2
    border-radius: 8
  }

  local_gate: "Local Pre-Push Runner\n«mise run test:affected»\n--\nctest -R <ctest_filter>\nuv run pytest <affected_py>" {
    class: external_system
  }

  ci_jobs: "GitHub Actions CI Matrix\n«.github/workflows/ci.yml»\n--\nConditional docs, lint and OS jobs\nEmits CTest and Pytest junit.xml" {
    class: external_system
  }

  gatekeeper: "Smart Gatekeeper and PR Auditor\n«ci:gate + ci:verify:pr»\n--\nStatic requirement mapping audit\nDynamic JUnit XML execution verification" {
    class: external_system
  }

  ci_jobs -> gatekeeper: junit.xml and job status {style.stroke-dash: 4}
}

# Cross-boundary relationships
inputs.codebase -> planner.graph_builder: "scans AST and #include directives"
inputs.git_diff -> planner.hop1: changed_files
inputs.git_diff -> planner.hop2: EP diffs and trailers
inputs.specs -> planner.hop2: REQ map and test tags

planner.hop3 -> consumers.local_gate: Execution Plan
planner.hop3 -> consumers.ci_jobs: GITHUB_OUTPUT flags and ctest_filter
planner.hop3 -> consumers.gatekeeper: required_checks and impacted REQs {style.stroke-dash: 4}

# C4 Styling Palette
classes: {
  internal_component: {
    style: {
      fill: "#eff6ff"
      stroke: "#1d4ed8"
      stroke-width: 2
      border-radius: 6
      font-color: "#1e3a8a"
    }
  }
  external_system: {
    style: {
      fill: "#ffffff"
      stroke: "#64748b"
      stroke-width: 2
      border-radius: 6
      font-color: "#334155"
    }
  }
}

#!/usr/bin/env bash
# ==============================================================================
# Pre-push Hook: Executes mise pre:push verification and checks release tags
# ==============================================================================
set -euo pipefail

# Clear inherited Git worktree environment variables (such as GIT_DIR) so child
# build tools (e.g. CMake FetchContent) can clone external repositories cleanly.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_PREFIX
export PATH="$HOME/.local/bin:$PATH"

# 1. Execute pre-push validation suite via mise (pre:push)
if [ "${RFL_SKIP_PRE_PUSH:-0}" != "1" ]; then
    mise run pre:push
fi

# 2. Read standard input: <local_ref> <local_sha> <remote_ref> <remote_sha>
while read -r local_ref local_sha remote_ref remote_sha; do
    if [[ "$remote_ref" == refs/tags/v* ]]; then
        TAG_NAME="${remote_ref#refs/tags/}"
        mise run release:verify -- --tag "$TAG_NAME"
    fi
done


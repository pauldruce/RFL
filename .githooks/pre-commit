#!/usr/bin/env bash
# ==============================================================================
# Pre-commit Hook: Shift-left spelling, link integrity, and traceability audit
# ==============================================================================
set -euo pipefail

# Clear inherited Git worktree environment variables (such as GIT_DIR)
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_PREFIX

# Find staged files (ignoring deleted files)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=d || true)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

# 1. Spelling verification via CSpell
echo "🔍 Checking staged files for spelling compliance (CSpell)..."

if command -v cspell >/dev/null 2>&1; then
    echo "$STAGED_FILES" | xargs cspell lint --dot --no-must-find-files
elif command -v npx >/dev/null 2>&1; then
    echo "$STAGED_FILES" | xargs npx cspell lint --dot --no-must-find-files
else
    echo "⚠️ Warning: Neither 'cspell' nor 'npx' is found. Skipping spell check."
fi

# 2. Markdown link validation when documentation files are staged
if echo "$STAGED_FILES" | grep -qE "\.md$"; then
    echo "🔗 Checking documentation links..."
    python3 scripts/check_links.py
fi

# 3. Specification traceability and requirement ID audit
if echo "$STAGED_FILES" | grep -qE "(docs/eps/|src/|tests/|scripts/)"; then
    echo "📋 Verifying requirement IDs and traceability..."
    python3 scripts/verify_traceability.py --audit
fi
